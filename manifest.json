{
  "manifest_version": 2,
  "name": "WA Focus",
  "version": "0.1.0",
  "description": "Hide the WhatsApp Web sidebar. Alt+Shift+S toggles; left edge peeks.",
  "browser_specific_settings": {
    "gecko": {
      "id": "wa-focus@nazzacode",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["wa.js"],
      "css": ["wa.css"],
      "run_at": "document_idle"
    }
  ]
}
